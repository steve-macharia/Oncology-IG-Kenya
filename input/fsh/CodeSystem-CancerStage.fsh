CodeSystem: CancerStageCS
Id: cancer-stage-codes
Title: "Cancer Stage Codes (local)"
Description: "Local placeholder code system for overall cancer stage groups (0 to IV) used in the Oncology IG for Kenya. To be mapped to SNOMED CT or AJCC codes."
* ^status = #draft
* #0 "Stage 0" "Carcinoma in situ"
* #I "Stage I"
* #II "Stage II"
* #III "Stage III"
* #IV "Stage IV" "Metastatic disease"
* #unknown "Stage unknown or not assessed"
